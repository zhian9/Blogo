# ================================
# Blogo 环境变量模板
# 复制此文件为 .env 并填入真实值
# ================================

# ---- 数据库 ----
DB_DSN=root:your_db_password@tcp(127.0.0.1:3306)/go_admin?charset=utf8mb4&parseTime=True&loc=Local

# ---- Redis ----
REDIS_PASSWORD=your_redis_password

# ---- 超级管理员 ----
# bcrypt 哈希，可通过 https://bcrypt.online 生成
ROOT_PASSWORD_HASH=your_bcrypt_hash_here

# ---- JWT ----
# 至少 32 字符随机字符串，部署前必须更换
JWT_SIGNING_KEY=your_jwt_signing_key_at_least_32_chars

# ---- 站点 ----
# 本地开发用 localhost，部署时改为域名（如 https://example.com）
SITE_URL=http://localhost:8040

# ---- CORS ----
# 允许的来源域名，多个用逗号分隔，* 表示全部
CORS_ALLOW_ORIGINS=*

# ---- 新用户默认密码（留空则不设置） ----
DEFAULT_LOGIN_PWD=

# ---- Prometheus Basic Auth ----
PROMETHEUS_USERNAME=admin
PROMETHEUS_PASSWORD=your_prometheus_password

# ---- Cloudflare R2 对象存储（选填，不填则回退到本地磁盘） ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# ---- 邮件服务（QQ邮箱 SMTP 授权码） ----
EMAIL_PASSWORD=your_smtp_auth_code
