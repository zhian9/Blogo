# ================================
# Blogo 环境变量模板
# 复制此文件为 .env 并填入真实值
# ================================

# ── 数据库 (MySQL) ──────────────────────────────────
# 本地: host=127.0.0.1
# Docker: host=mysql, password 需与 MYSQL_PASSWORD 一致
DB_DSN=blogo:blogo@tcp(127.0.0.1:3306)/blogo?charset=utf8mb4&parseTime=True&loc=Local

# Docker Compose 中 MySQL 的 root 密码
MYSQL_ROOT_PASSWORD=root123456
# Docker Compose 中 MySQL 的应用账号
MYSQL_USER=blogo
MYSQL_PASSWORD=blogo123456
MYSQL_DATABASE=blogo

# ── Redis ──────────────────────────────────────────
REDIS_PASSWORD=your_redis_password

# ── 超级管理员 ──────────────────────────────────────
ROOT_ID=root
ROOT_USERNAME=admin
ROOT_NAME=系统管理员
# bcrypt 哈希，通过 https://bcrypt.online 生成
ROOT_PASSWORD_HASH=your_bcrypt_hash_here

# ── JWT ────────────────────────────────────────────
# 至少 32 字符随机字符串，部署前必须更换
JWT_SIGNING_KEY=your_jwt_signing_key_at_least_32_chars

# ── 站点 ───────────────────────────────────────────
# 本地开发: http://localhost:8040
# 部署: https://blogo.cloud
SITE_URL=http://localhost:8040

# ── CORS ───────────────────────────────────────────
# 开发: *
# 部署: https://blogo.cloud,https://admin.blogo.cloud
CORS_ALLOW_ORIGINS=*

# ── 新用户默认密码（留空不设置）─────────────────────
DEFAULT_LOGIN_PWD=

# ── Prometheus ─────────────────────────────────────
PROMETHEUS_USERNAME=admin
PROMETHEUS_PASSWORD=your_prometheus_password

# ── Cloudflare R2 对象存储（选填）────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# ── 邮件服务（QQ 邮箱 SMTP）─────────────────────────
EMAIL_PASSWORD=your_smtp_auth_code
EMAIL_PASSWORD=your_smtp_auth_code
